{
  "name": "gerenciamento-obras-ambientais",
  "version": "1.0.0",
  "description": "API REST para consulta de obras sustentáveis",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "test": "jest --coverage",
    "dev": "nodemon src/api/server.js",
    "db:reset": "sequelize-cli db:drop && npx sequelize-cli db:create && npx sequelize-cli db:migrate && npx sequelize-cli db:seed:all",
    "token": "node scripts/generate-token.js"
  },
  "author": "Gabriel Dalseco",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22"
  }
}
